# Plantilla. Copiar a .env: app/config.py lo lee solo al arrancar, y ese archivo
# no se versiona. En el servidor las variables van en el entorno, que le gana al
# .env si las dos están.

# Obligatoria en producción: sin esto las sesiones se invalidan en cada reinicio.
CLAVE_SECRETA=poner-una-cadena-larga-y-aleatoria

BASE_DATOS_URL=sqlite:///scout.db
ZONA_HORARIA=America/Argentina/Buenos_Aires

# Cookie de sesión Secure: 1 donde haya HTTPS, 0 en local.
COOKIES_SEGURAS=0

# Journal de SQLite: WAL sobre un disco local, DELETE sobre un recurso de red
# (Azure Files, SMB, NFS), donde WAL directamente no funciona.
SQLITE_JOURNAL=WAL
SQLITE_ESPERA_MS=5000

# Validador de evidencias: manual | simulado
# manual   -> todo va a la cola del educador
# simulado -> revisa que la evidencia esté completa; nunca rechaza por sí solo
VALIDADOR=simulado

PUNTAJE_POR_DEFECTO=10
DIR_SUBIDAS=uploads
MAX_BYTES_FOTO=5242880
